@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@base <http://www.hesge.ch/metafair/ontologies/fields#> .

<http://www.hesge.ch/metafair/ontologies/fields> rdf:type owl:Ontology ;
                                                                owl:imports <https://raw.githubusercontent.com/y-schatz/metafair/refs/heads/main/ontologies/core.owl> .

