@prefix : <http://www.hesge.ch/metafair/ontologies/objects/construction#> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix xml: <http://www.w3.org/XML/1998/namespace> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .
@prefix core: <http://www.hesge.ch/metafair/ontologies/core#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix formats: <http://www.hesge.ch/metafair/ontologies/formats#> .
@base <http://www.hesge.ch/metafair/ontologies/objects/construction#> .

<http://www.hesge.ch/metafair/ontologies/objects/construction> rdf:type owl:Ontology ;
                                                                          owl:imports <https://raw.githubusercontent.com/y-schatz/metafair/refs/heads/main/ontologies/attributes.owl> ,
                                                                                      <https://raw.githubusercontent.com/y-schatz/metafair/refs/heads/main/ontologies/core.owl> ,
                                                                                      <https://raw.githubusercontent.com/y-schatz/metafair/refs/heads/main/ontologies/formats.owl> .

#################################################################
#    Individuals
#################################################################

###  http://www.hesge.ch/metafair/ontologies/objects/construction#BIMModel
:BIMModel rdf:type owl:NamedIndividual ,
                   core:DataArtifact ;
          core:hasAttribute <http://www.hesge.ch/metafair/ontologies/attributes#Boolean> ,
                            <http://www.hesge.ch/metafair/ontologies/attributes#Date> ,
                            <http://www.hesge.ch/metafair/ontologies/attributes#Label> ;
          core:hasFormat formats:IndustryFoundationClasses ;
          rdfs:label "BIM Model"@en .